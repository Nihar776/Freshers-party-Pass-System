# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# A SEPARATE random secret for login sessions - never reuse SECRET_KEY here.
SESSION_SECRET_KEY=replace-with-a-different-long-random-secret
SESSION_TTL_HOURS=12
BOOTSTRAP_SECRET=set-a-random-string-here-then-visit-slash-bootstrap-admin-page
# Optional: cap how long a pass token stays valid (leave unset = no expiry)
# PASS_TOKEN_TTL_HOURS=72

# --- Event metadata (shown in emails and the scanner header) ---
EVENT_ID=FRESHERS_2026
EVENT_NAME=Freshers' Party 2026
EVENT_VENUE=College Main Auditorium
EVENT_DATE=2026-10-18

# --- Database ---
DATABASE_URL=sqlite:///./event_passes.db

# --- SMTP (Gmail example: use a 16-char App Password, not your login password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USER=your_event_account@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=College Fest Team

# --- SendGrid alternative (uncomment and use instead of Gmail) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USE_STARTTLS=true
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

APP_BASE_URL=http://localhost:8000
